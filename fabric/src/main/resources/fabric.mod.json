{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "license": "${mod_license}",
  "icon": "assets/dreamtvs/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.dreamtvs.fabric.DreamTvsFabric"
    ],
    "client": [
      "com.dreamtvs.fabric.DreamTvsFabricClient"
    ],
    "modmenu": [
      "com.dreamtvs.fabric.DreamTvsModMenu"
    ]
  },
  "mixins": [
    "dreamtvs.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "dreamdisplays": ">=${dreamdisplays_version}"
  }
}
